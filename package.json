{
  "name": "eumaeus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted agent harness: one disposable VM per job",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/mcp-smoke.ts",
    "start:service": "scripts/dispatcher.sh",
    "service": "scripts/service.sh"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@10.30.2",
  "license": "MIT"
}
